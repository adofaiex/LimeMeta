{
  "$schema": "http://json.schemastore.org/template",
  "author": "adofaiex",
  "classifications": [
    "Web",
    "API",
    "GraphQL",
    "Backend"
  ],
  "identity": "LimeMeta.Service.Template",
  "name": "LimeMeta Service",
  "shortName": "limemeta",
  "sourceName": "LimeMetaService",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "primaryOutputs": [
    {
      "path": "LimeMetaService.sln"
    },
    {
      "path": "LimeMetaService/LimeMetaService.csproj"
    },
    {
      "path": "LimeMetaService.WebAPI/LimeMetaService.WebAPI.csproj"
    },
    {
      "path": "LimeMeta/LimeMeta.csproj"
    },
    {
      "path": "LimeMeta.GraphQL/LimeMeta.GraphQL.csproj"
    }
  ],
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**",
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "*.user",
        "*.suo"
      ]
    }
  ]
}

